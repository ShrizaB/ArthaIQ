# Copy this file to .env and fill in your values

# Anthropic API key — required for AI Advisor
# Get yours at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL connection string — optional (app runs with mock data without it)
DATABASE_URL=postgresql://user:password@localhost:5432/arthaiq

# Civic Auth client ID — replace with your own from civic.com
# The default client ID is for development only
VITE_CIVIC_CLIENT_ID=033dab32-dc69-4b66-a676-341ad4e0d8ea
